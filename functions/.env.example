# Copy this file to `.env` for LOCAL EMULATOR testing only (functions/.env
# is git-ignored - never commit real values). It has no effect on the
# deployed function; that value comes from Secret Manager instead, set once
# with:
#
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
#
# (prompts for the value interactively, so it never touches disk or git).
# See the README for the full one-time setup, including generating a new
# Google Account App Password - the old one, previously hardcoded in
# functions/index.js, must be treated as compromised and revoked.

GMAIL_USER=mr.hadas@gmail.com
GMAIL_APP_PASSWORD=
